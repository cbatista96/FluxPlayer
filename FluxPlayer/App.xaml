<Application x:Class="FluxPlayer.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:conv="clr-namespace:FluxPlayer.Converters" xmlns:fx="clr-namespace:FluxPlayer.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />

                <ResourceDictionary Source="Themes/PlayerStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
            <conv:InverseBoolConverter x:Key="InvBool" />
            <conv:PlayingToIconConverter x:Key="PlayIcon" />
            <conv:PlayingToTooltipConverter x:Key="PlayTooltip" />
            <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
            <conv:RepeatModeToOpacityConverter x:Key="RepeatOpacity" />
            <conv:RepeatModeToIconConverter x:Key="RepeatIcon" />
            <conv:PlayingToBackgroundConverter x:Key="PlayingBg" />
            <conv:VolumeToIconConverter x:Key="VolumeIcon" />
            <conv:PathToFileNameConverter x:Key="PathToFileName" />
            <conv:NonZeroToActiveTagConverter x:Key="ActiveTag" />
            <conv:ZeroToVisibleConverter x:Key="ZeroToVisible" />

            <Thickness x:Key="ComboBoxPadding">10,6,10,6</Thickness>

            <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                <Setter Property="fx:SmoothScroll.IsEnabled" Value="True" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="box" Width="20" Height="20" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="boxScale" ScaleX="1" ScaleY="1" />
                                    </Grid.RenderTransform>
                                    <Border x:Name="frame" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Background="{DynamicResource ControlAltFillColorSecondaryBrush}" />
                                    <Border x:Name="fill" CornerRadius="4" Opacity="0" Background="{DynamicResource FxAccentTextBrush}" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="fillScale" ScaleX="0.3" ScaleY="0.3" />
                                        </Border.RenderTransform>
                                    </Border>

                                    <Path x:Name="check" Data="M 5.4,10.4 L 8.5,13.5 L 14.7,6.7" Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="8 8" StrokeDashOffset="8" />
                                </Grid>
                                <ContentPresenter x:Name="content" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasContent" Value="False">
                                    <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="frame" Property="Background" Value="{DynamicResource ControlAltFillColorTertiaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="frame" Property="BorderBrush" Value="Transparent" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="fillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="fillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="check" Storyboard.TargetProperty="StrokeDashOffset" To="0" BeginTime="0:0:0.08" Duration="0:0:0.24">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleX">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="0.86" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1">
                                                        <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8" /></EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleY">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="0.86" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1">
                                                        <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8" /></EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="check" Storyboard.TargetProperty="StrokeDashOffset" To="8" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.06" Duration="0:0:0.16" />
                                                <DoubleAnimation Storyboard.TargetName="fillScale" Storyboard.TargetProperty="ScaleX" To="0.3" BeginTime="0:0:0.06" Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetName="fillScale" Storyboard.TargetProperty="ScaleY" To="0.3" BeginTime="0:0:0.06" Duration="0:0:0.18" />
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleX">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="0.88" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.26" Value="1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="boxScale" Storyboard.TargetProperty="ScaleY">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="0.88" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.26" Value="1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="#E61A1F2A" />
                <Setter Property="BorderBrush" Value="#30FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#F2F2F2" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="#F2F2F2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Margin="2,1" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="icon" Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="check" Grid.Column="0" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#60CDFF" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />

                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="8,0,16,0" RecognizesAccessKey="True" />

                                    <Grid Grid.Column="2" MinWidth="14">
                                        <TextBlock x:Name="gesture" Text="{TemplateBinding InputGestureText}" Opacity="0.55" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <Path x:Name="arrow" Data="M 0,0 L 4,4 L 0,8 Z" Fill="#A0FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0" Visibility="Collapsed" />
                                    </Grid>

                                    <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                        <Border Background="#E61A1F2A" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="4">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
                                            </Border.Effect>
                                            <StackPanel IsItemsHost="True" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#28FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="check" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="icon" Property="Visibility" Value="Hidden" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#60FFFFFF" />
                                </Trigger>
                                <Trigger Property="Role" Value="SubmenuHeader">
                                    <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="gesture" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Role" Value="TopLevelHeader">
                                    <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="gesture" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Rectangle Height="1" Margin="6,4" Fill="#22FFFFFF" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>

</Application>
