<UserControl x:Class="FluxPlayer.Controls.SettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FluxPlayer.Controls" UseLayoutRounding="True" Background="Transparent">

    <UserControl.Resources>

        <SolidColorBrush x:Key="PlayerHoverBrush" Color="{DynamicResource FxHoverColor}" />
        <SolidColorBrush x:Key="PlayerPressedBrush" Color="{DynamicResource FxPressedColor}" />
        <SolidColorBrush x:Key="ChipBrush" Color="{DynamicResource FxChipColor}" />
        <SolidColorBrush x:Key="ChipBorderBrush" Color="{DynamicResource FxChipBorderColor}" />

        <Style x:Key="OptionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FxCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FxCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="OptTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="OptSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHdr" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="SubsectionHdr" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Background" Value="{DynamicResource FxChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FxChipBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Focusable" Value="True" />
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{DynamicResource FxDangerBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FxDangerBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FxDangerTextBrush}" />
        </Style>
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{DynamicResource FxSuccessBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FxSuccessBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FxSuccessTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource FxSurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource FxAccentTextBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="Settings" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseBtn}" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="" ToolTip="Close (Esc)" Click="CancelBtn_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource FxDividerBrush}" BorderThickness="0,1,1,0" Background="{DynamicResource FxSidebarBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{DynamicResource FxAccentTextBrush}" HorizontalAlignment="Center" Margin="0,18,0,12" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" SelectionChanged="CategoryList_SelectionChanged" SelectedIndex="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="14,10" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="6,1" Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="26" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="fxIcon" Grid.Column="0" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Foreground="{TemplateBinding Foreground}" />
                                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                                            <Border x:Name="selBar" Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-11,0,0,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource FxAccentTextBrush}">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform x:Name="selScale" ScaleY="1" />
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource FxHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource FxAccentSoftBrush}" />
                                                            <Setter TargetName="selBar" Property="Visibility" Value="Visible" />
                                                            <Setter Property="Foreground" Value="{DynamicResource FxAccentTextBrush}" />
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="selScale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.32">
                                                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7" /></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBoxItem Content="General" Tag="" local:ButtonFx.IconEffect="SpinCW" />
                                <ListBoxItem Content="Playback" Tag="" local:ButtonFx.IconEffect="NudgeRight" />
                                <ListBoxItem Content="Video" Tag="" local:ButtonFx.IconEffect="Pop" />
                                <ListBoxItem Content="Audio" Tag="" local:ButtonFx.IconEffect="Wiggle" />
                                <ListBoxItem Content="Subtitles" Tag="" local:ButtonFx.IconEffect="Bounce" />
                                <ListBoxItem Content="Keyboard shortcuts" Tag="" local:ButtonFx.IconEffect="Bounce" />
                                <ListBoxItem Content="Mouse" Tag="" local:ButtonFx.IconEffect="Wiggle" />
                                <ListBoxItem Content="Locations" Tag="" local:ButtonFx.IconEffect="Bounce" />
                                <ListBoxItem Content="Accessibility" Tag="" local:ButtonFx.IconEffect="Pop" />
                                <ListBoxItem Content="Features" Tag="" local:ButtonFx.IconEffect="Wiggle" />
                                <ListBoxItem Content="About" Tag="" local:ButtonFx.IconEffect="SpinCW" />
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="24,18,24,24">
                    <Grid>

                        <StackPanel x:Name="PageGeneral">
                            <TextBlock Text="General" Style="{StaticResource SectionHdr}" />

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Theme" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Change the window appearance (Mica, Acrylic, Black)" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeComboSetting" Grid.Column="1" Width="160" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Dark Mica" Tag="DarkMica" />
                                        <ComboBoxItem Content="Light Mica" Tag="LightMica" />
                                        <ComboBoxItem Content="Full Black" Tag="FullBlack" />
                                        <ComboBoxItem Content="Acrylic Blur" Tag="AcrylicBlur" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Language" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Interface language" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="160" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="English" Tag="English" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Always on top" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Keep the window above other windows" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <ComboBox x:Name="AlwaysOnTopCombo" Grid.Column="1" Width="200" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Never" Tag="Never" />
                                        <ComboBoxItem Content="While playing" Tag="WhilePlaying" />
                                        <ComboBoxItem Content="Always" Tag="Always" />
                                        <ComboBoxItem Content="In fullscreen" Tag="Fullscreen" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="When opening files" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Behavior when opening media files" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <ComboBox x:Name="FileOpenCombo" Grid.Column="1" Width="200" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Open similar files together" Tag="OpenSimilarTogether" />
                                        <ComboBoxItem Content="Selected file only" Tag="OpenOnlyOne" />
                                        <ComboBoxItem Content="Add to playlist" Tag="AddToPlaylist" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <TextBlock Text="Window behavior" Style="{StaticResource SubsectionHdr}" />

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Remember window position" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Open the window where you last left it" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="RememberPositionToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Window size" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Default size, last used size or the actual video resolution" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <ComboBox x:Name="WindowSizeModeCombo" Grid.Column="1" Width="220" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Default" Tag="Default" />
                                        <ComboBoxItem Content="Remember when closing" Tag="Remember" />
                                        <ComboBoxItem Content="Fit to video (100%)" Tag="FitVideo" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Show playlist at startup" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Open the playlist sidebar automatically" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ShowPlaylistToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Snap to edges" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Snap the window to screen edges" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="SnapEdgesToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Pause when minimized" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Pause playback when minimized" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PauseOnMinToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Pause when focus is lost" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Pause when another window gains focus" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PauseOnBlurToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Pause when screen is locked" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Pause when Windows is locked" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PauseOnLockToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Show tooltips" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Show help when hovering over controls" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="TooltipsToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock Text="System" Style="{StaticResource SubsectionHdr}" />

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="System tray icon" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Show taskbar icon" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="TrayIconToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Minimize to tray" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Hide the window in the system tray when minimized" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="MinimizeToTrayToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Taskbar features" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Show progress and thumbnails on the taskbar" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="TaskbarFeaturesToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="System controls" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Allow control through media keys and SMTC" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="SystemMediaControlsToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Multiple instances" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Allow multiple windows at once" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <CheckBox x:Name="MultiInstanceToggle" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Check for updates" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Update check frequency" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <ComboBox x:Name="UpdateModeCombo" Grid.Column="1" Width="160" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Always" Tag="Always" />
                                        <ComboBoxItem Content="Manual" Tag="Manual" />
                                        <ComboBoxItem Content="Never" Tag="Never" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <TextBlock Text="Recent files" Style="{StaticResource SubsectionHdr}" />

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Maximum number" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Number of files retained in the recent list" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <ComboBox x:Name="MaxRecentCombo" Grid.Column="1" Width="80" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="5" Tag="5" />
                                        <ComboBoxItem Content="10" Tag="10" />
                                        <ComboBoxItem Content="20" Tag="20" />
                                        <ComboBoxItem Content="30" Tag="30" />
                                        <ComboBoxItem Content="50" Tag="50" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Clear recent files" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Clear playback history" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource DangerBtn}" Click="ClearRecentBtn_Click" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Settings folder" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Open the folder containing settings.json" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open folder" Style="{StaticResource ActionBtn}" Click="OpenConfigFolderBtn_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PagePlayback" Visibility="Collapsed">
                            <TextBlock Text="Playback" Style="{StaticResource SectionHdr}" />

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Default volume" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Volume when the application starts" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="VolumeSliderSetting" Width="110" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                                        <TextBlock x:Name="VolumeLabel" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" MinWidth="32" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Volume step" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Keyboard / wheel adjustment step" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <TextBox x:Name="VolumeStepBox" Grid.Column="1" Width="80" Height="32" VerticalContentAlignment="Center" Text="5" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Default speed" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Playback speed at startup" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <ComboBox x:Name="SpeedComboSetting" Grid.Column="1" Width="100" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="0.25x" Tag="0.25" />
                                        <ComboBoxItem Content="0.5x" Tag="0.5" />
                                        <ComboBoxItem Content="0.75x" Tag="0.75" />
                                        <ComboBoxItem Content="1x" Tag="1" />
                                        <ComboBoxItem Content="1.25x" Tag="1.25" />
                                        <ComboBoxItem Content="1.5x" Tag="1.5" />
                                        <ComboBoxItem Content="2x" Tag="2" />
                                        <ComboBoxItem Content="3x" Tag="3" />
                                        <ComboBoxItem Content="4x" Tag="4" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Small seek step (seconds)" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Seek step for Left/Right arrows" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <TextBox x:Name="SeekStepBox" Grid.Column="1" Width="80" Height="32" VerticalContentAlignment="Center" Text="10" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Large seek step (seconds)" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="Seek step for Page Up/Down" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <TextBox x:Name="SeekLargeStepBox" Grid.Column="1" Width="80" Height="32" VerticalContentAlignment="Center" Text="60" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Repeat mode" Style="{StaticResource OptTitle}" />
                                        <TextBlock Text="How to repeat the playlist when it ends" Style="{StaticResource OptSub}" />
                                    </StackPanel>
                                    <ComboBox x:Name="RepeatComboSetting" Grid.Column="1" Width="140" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Do not repeat" Tag="None" />
                                        <ComboBoxItem Content="Repeat all" Tag="All" />
                                        <ComboBoxItem Content="Repeat one" Tag="One" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OptionCard}">
                                <Grid>
