                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1.35" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="1.0" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="1.35" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.60" Value="1.0" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.30" Value="1.0" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleY">
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="1.0" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1.35" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="1.0" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="1.35" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.60" Value="1.0" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.30" Value="1.0" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                        </TextBlock>
                                        <TextBlock Text=" in Miami, FL" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource FxDividerBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource FxFooterBrush}" Padding="18,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="100" Height="34" Margin="0,0,8,0" Click="CancelBtn_Click" Style="{StaticResource ActionBtn}" ToolTip="Discard changes (Esc)" />
                    <Button Content="Save" MinWidth="110" Height="34" Click="SaveBtn_Click" Style="{StaticResource AccentButton}" ToolTip="Save and apply" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
