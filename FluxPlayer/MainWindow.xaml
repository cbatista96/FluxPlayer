                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#BB000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
