<ui:FluentWindow x:Class="FluxPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:FluxPlayer.Controls" mc:Ignorable="d" Title="{Binding WindowTitle}" Height="760" Width="1280" MinHeight="500" MinWidth="760" WindowStyle="None" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True" Background="Transparent" ResizeMode="CanResize" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" MouseMove="Window_MouseMove" PreviewMouseDown="Window_PreviewMouseDown" PreviewMouseWheel="Window_PreviewMouseWheel" PreviewMouseUp="Window_PreviewMouseUp" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo" />
    </Window.TaskbarItemInfo>

    <Window.ContextMenu>
        <ContextMenu x:Name="MainContextMenu" Opened="MainContextMenu_Opened">
            <MenuItem Header="Open file..." controls:HotkeyHint.Action="OpenFile" Click="CtxOpenFile_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open network URL..." controls:HotkeyHint.Action="OpenUrl" Click="CtxOpenUrl_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Recent files" Click="CtxRecent_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Close playback" Click="CtxClose_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />

            <MenuItem Header="Play">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
                <MenuItem Header="Play / pause" controls:HotkeyHint.Action="PlayPause" Click="CtxPlayPause_Click" />
                <MenuItem Header="Previous" controls:HotkeyHint.Action="PreviousTrack" Click="CtxPrev_Click" />
                <MenuItem Header="Next" controls:HotkeyHint.Action="NextTrack" Click="CtxNext_Click" />
                <Separator />
                <MenuItem Header="Speed">
                    <MenuItem Header="0.25x" Tag="0.25" Click="CtxSpeed_Click" />
                    <MenuItem Header="0.5x" Tag="0.5" Click="CtxSpeed_Click" />
                    <MenuItem Header="0.75x" Tag="0.75" Click="CtxSpeed_Click" />
                    <MenuItem Header="1x (Normal)" Tag="1.0" Click="CtxSpeed_Click" />
                    <MenuItem Header="1.25x" Tag="1.25" Click="CtxSpeed_Click" />
                    <MenuItem Header="1.5x" Tag="1.5" Click="CtxSpeed_Click" />
                    <MenuItem Header="1.75x" Tag="1.75" Click="CtxSpeed_Click" />
                    <MenuItem Header="2x" Tag="2.0" Click="CtxSpeed_Click" />
                    <MenuItem Header="3x" Tag="3.0" Click="CtxSpeed_Click" />
                </MenuItem>
                <MenuItem x:Name="CtxSeekBackItem" Header="Seek backward" Click="CtxSeekBack_Click" />
                <MenuItem x:Name="CtxSeekFwdItem" Header="Seek forward" Click="CtxSeekFwd_Click" />
                <MenuItem Header="Next frame" controls:HotkeyHint.Action="FrameForward" Click="CtxFrameFwd_Click" />
                <Separator />
                <MenuItem Header="A-B loop" controls:HotkeyHint.Action="ToggleAbLoop" Click="CtxAbLoop_Click" />
                <MenuItem Header="Export A-B clip..." Click="CtxExportClip_Click" />
                <MenuItem Header="Repeat one" Click="CtxRepeatOne_Click" />
                <MenuItem Header="Repeat all" Click="CtxRepeatAll_Click" />
                <MenuItem Header="Shuffle playback" Click="CtxShuffle_Click" />
            </MenuItem>

            <MenuItem x:Name="CtxBookmarksMenu" Header="Bookmarks">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
                <MenuItem Header="Add bookmark here" controls:HotkeyHint.Action="AddBookmark" Click="CtxBookmarkAdd_Click" />
                <MenuItem Header="Next bookmark" controls:HotkeyHint.Action="NextBookmark" Click="CtxBookmarkNext_Click" />
                <MenuItem Header="Previous bookmark" controls:HotkeyHint.Action="PreviousBookmark" Click="CtxBookmarkPrev_Click" />
                <Separator x:Name="CtxBookmarkListSeparator" />
                <MenuItem x:Name="CtxBookmarkClearItem" Header="Clear all bookmarks" Click="CtxBookmarkClear_Click" />
            </MenuItem>

            <MenuItem x:Name="CtxSleepMenu" Header="Sleep timer">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
                <MenuItem Header="Disabled" Tag="0" Click="CtxSleep_Click" />
                <Separator />
                <MenuItem Header="15 minutes" Tag="15" Click="CtxSleep_Click" />
                <MenuItem Header="30 minutes" Tag="30" Click="CtxSleep_Click" />
                <MenuItem Header="45 minutes" Tag="45" Click="CtxSleep_Click" />
                <MenuItem Header="1 hour" Tag="60" Click="CtxSleep_Click" />
                <MenuItem Header="1 hour 30 minutes" Tag="90" Click="CtxSleep_Click" />
                <MenuItem Header="2 hours" Tag="120" Click="CtxSleep_Click" />
                <Separator />
                <MenuItem Header="After the current file" Tag="end" Click="CtxSleep_Click" />
            </MenuItem>

            <MenuItem Header="Subtitles">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
                <MenuItem Header="Load external subtitle..." Click="CtxLoadSub_Click" />
                <MenuItem Header="Show / hide" Click="CtxToggleSubs_Click" />
                <Separator />
                <MenuItem x:Name="CtxSubDelayPlusItem" Header="Delay subtitles" Click="CtxSubDelayPlus_Click" />
                <MenuItem x:Name="CtxSubDelayMinusItem" Header="Advance subtitles" Click="CtxSubDelayMinus_Click" />
                <MenuItem Header="Reset delay" Click="CtxSubDelayReset_Click" />
            </MenuItem>

            <MenuItem Header="Video">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
                <MenuItem Header="Take snapshot" controls:HotkeyHint.Action="TakeSnapshot" Click="CtxSnapshot_Click" />
                <MenuItem x:Name="CtxAmbientItem" Header="Ambient light" IsCheckable="True" controls:HotkeyHint.Action="ToggleAmbientLight" Click="CtxAmbient_Click" />
                <Separator />
                <MenuItem Header="Aspect ratio">
                    <MenuItem Header="Auto" Tag="Auto" Click="CtxAspect_Click" />
                    <MenuItem Header="16:9" Tag="16:9" Click="CtxAspect_Click" />
                    <MenuItem Header="4:3" Tag="4:3" Click="CtxAspect_Click" />
                    <MenuItem Header="21:9" Tag="21:9" Click="CtxAspect_Click" />
                    <MenuItem Header="1:1" Tag="1:1" Click="CtxAspect_Click" />
                    <MenuItem Header="Stretch" Tag="Stretch" Click="CtxAspect_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Increase brightness" Click="CtxBrightnessUp_Click" />
                <MenuItem Header="Decrease brightness" Click="CtxBrightnessDown_Click" />
                <MenuItem Header="Increase contrast" Click="CtxContrastUp_Click" />
                <MenuItem Header="Decrease contrast" Click="CtxContrastDown_Click" />
                <MenuItem Header="Reset picture" Click="CtxResetVideo_Click" />
            </MenuItem>

            <MenuItem Header="Audio">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
                <MenuItem x:Name="CtxVolumeUpItem" Header="Volume up" Click="CtxVolumeUp_Click" />
                <MenuItem x:Name="CtxVolumeDownItem" Header="Volume down" Click="CtxVolumeDown_Click" />
                <MenuItem Header="Mute" controls:HotkeyHint.Action="ToggleMute" Click="CtxMute_Click" />
                <Separator />
                <MenuItem Header="Equalizer..." controls:HotkeyHint.Action="ToggleEqualizer" Click="CtxEqualizer_Click" />
                <Separator />
                <MenuItem x:Name="CtxAudioDelayPlusItem" Header="Delay audio" Click="CtxAudioDelayPlus_Click" />
                <MenuItem x:Name="CtxAudioDelayMinusItem" Header="Advance audio" Click="CtxAudioDelayMinus_Click" />
            </MenuItem>

            <Separator />

            <MenuItem Header="Window size">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
                <MenuItem Header="50%" Tag="0.5" Click="CtxWindowSize_Click" />
                <MenuItem Header="75%" Tag="0.75" Click="CtxWindowSize_Click" />
                <MenuItem Header="100% (original)" Tag="1.0" Click="CtxWindowSize_Click" />
                <MenuItem Header="150%" Tag="1.5" Click="CtxWindowSize_Click" />
                <MenuItem Header="200%" Tag="2.0" Click="CtxWindowSize_Click" />
                <Separator />
                <MenuItem Header="Fit to video aspect ratio" Click="CtxFitVideo_Click" />
            </MenuItem>

            <MenuItem Header="Fullscreen" controls:HotkeyHint.Action="ToggleFullscreen" Click="CtxFullscreen_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Mini player" controls:HotkeyHint.Action="MiniPlayer" Click="CtxMiniPlayer_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Lock controls" controls:HotkeyHint.Action="ToggleControlLock" Click="CtxLock_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <MenuItem Header="Show / hide playlist" controls:HotkeyHint.Action="TogglePlaylist" Click="CtxTogglePlaylist_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Media information" controls:HotkeyHint.Action="ToggleMediaInfo" Click="CtxMediaInfo_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <MenuItem Header="Preferences..." controls:HotkeyHint.Action="OpenSettings" Click="CtxPreferences_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="About..." Click="CtxAbout_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="CtxExit_Click">
                <MenuItem.Icon>
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>

        <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Popup.Placement" Value="Top" />
        </Style>

        <SolidColorBrush x:Key="PlayerPrimaryForegroundBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="PlayerSecondaryForegroundBrush" Color="#CCEEEEEE" />
        <SolidColorBrush x:Key="PlayerHoverBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="PlayerPressedBrush" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="PlayerSeparatorBrush" Color="#28FFFFFF" />
        <SolidColorBrush x:Key="ChromeTintBrush" Color="#A0101620" />

        <Style x:Key="SeekGlyphButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Width="26" Height="26">

                            <Grid x:Name="fxIcon">
                                <TextBlock x:Name="arrow" Text="" FontFamily="Segoe Fluent Icons" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                            </Grid>
                            <TextBlock Text="{Binding DataContext.SeekStepSeconds, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="Segoe UI" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="-1">
                                <Setter TargetName="arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="-1" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaylistItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="6,2">
                            <Border x:Name="bg" CornerRadius="8" Background="Transparent" />
                            <Border x:Name="hover" CornerRadius="8" Opacity="0" Background="{DynamicResource PlayerHoverBrush}" />
                            <Border x:Name="accentBar" Width="3" Height="20" CornerRadius="1.5" HorizontalAlignment="Left" Margin="1,0,0,0" Background="{StaticResource AccentGradientBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="10,7,6,7" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource FxHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="accentBar" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="44" Background="{DynamicResource ChromeTintBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <TextBlock Text="FluxPlayer" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PlayerPrimaryForegroundBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding WindowTitle}" FontSize="12" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">

                <Button x:Name="PlayerModeButton" Style="{StaticResource TransportButton}" Padding="10,0" Height="32" Click="PlayerModeButton_Click" ToolTip="Playback mode" AutomationProperties.Name="Change playback mode">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ModeLabel}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="8" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="PlayerModeMenu">
                            <MenuItem Header="Automatic based on content" Tag="Automatic" Click="PlayerModeItem_Click" />
                            <MenuItem Header="Audio mode" Tag="Audio" Click="PlayerModeItem_Click" />
                            <MenuItem Header="Video mode" Tag="Video" Click="PlayerModeItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource TransportButton}" Width="36" Height="36" Click="LibraryButton_Click" ToolTip="Media library" AutomationProperties.Name="Open media library">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="15" />
                </Button>
                <Button x:Name="MediaToolsButton" Style="{StaticResource TransportButton}" Width="36" Height="36" Click="MediaToolsButton_Click" ToolTip="Audio and video tools" AutomationProperties.Name="Audio and video tools">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="15" />
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MediaToolsMenu" Opened="MediaToolsMenu_Opened">
                            <MenuItem Header="Media library" Click="LibraryButton_Click" />
                            <MenuItem Header="Batch audio converter…" Click="ConverterButton_Click" />
                            <MenuItem x:Name="OutputDevicesMenu" Header="Output device" />
                            <MenuItem Header="ReplayGain">
                                <MenuItem Header="Disabled" Tag="none" Click="ReplayGainItem_Click" />
                                <MenuItem Header="By track" Tag="track" Click="ReplayGainItem_Click" />
                                <MenuItem Header="By album" Tag="album" Click="ReplayGainItem_Click" />
                            </MenuItem>
                            <MenuItem x:Name="ChaptersMenu" Header="Chapters" />
                            <Separator />
                            <MenuItem Header="Edit tags for the current file…" Click="EditTagsButton_Click" />
                            <MenuItem Header="Batch tag editor…" Click="BatchTagsButton_Click" />
                            <MenuItem Header="Search external subtitles…" Click="SearchSubtitlesButton_Click" />
                            <MenuItem Header="Subtitle timing editor…" Click="SubtitleTiming_Click" />
                            <MenuItem Header="Open CUE sheet…" Click="OpenCueButton_Click" />
                            <MenuItem Header="Create or edit CUE sheet…" Click="EditCueButton_Click" />
                            <MenuItem Header="Scheduled snapshots…" Click="ScheduledSnapshots_Click" />
                            <Separator />
                            <MenuItem Header="Rotate picture 90°" Click="RotateVideo_Click" />
                            <MenuItem Header="Mirror picture" Click="MirrorVideo_Click" />
                            <MenuItem Header="Reset orientation" Click="ResetOrientation_Click" />
                            <MenuItem Header="Signal path and information" Click="SignalPath_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <ComboBox x:Name="ThemeCombo" Visibility="Collapsed" SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="Dark Mica" Tag="DarkMica" />
                    <ComboBoxItem Content="Light Mica" Tag="LightMica" />
                    <ComboBoxItem Content="Full Black" Tag="FullBlack" />
                    <ComboBoxItem Content="Acrylic Blur" Tag="AcrylicBlur" />
                </ComboBox>

                <Button x:Name="ThemeBtn" Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="14" ToolTip="Theme" controls:ButtonFx.IconEffect="Wiggle" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,2,0" Click="ThemeBtn_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ThemeMenu" MinWidth="190">
                            <MenuItem Header="Dark Mica" Tag="DarkMica" Click="ThemeMenuItem_Click">
                                <MenuItem.Icon><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Light Mica" Tag="LightMica" Click="ThemeMenuItem_Click">
                                <MenuItem.Icon><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Full Black" Tag="FullBlack" Click="ThemeMenuItem_Click">
                                <MenuItem.Icon><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Acrylic Blur" Tag="AcrylicBlur" Click="ThemeMenuItem_Click">
                                <MenuItem.Icon><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="14" ToolTip="Playlist" controls:HotkeyHint.Action="TogglePlaylist" Tag="{Binding IsPlaylistVisible, Converter={StaticResource ActiveTag}}" WindowChrome.IsHitTestVisibleInChrome="True" Click="TogglePlaylistBtn_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="14" ToolTip="Open network URL" controls:HotkeyHint.Action="OpenUrl" Command="{Binding OpenUrlCommand}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="2,0,0,0">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="14" ToolTip="Settings" controls:HotkeyHint.Action="OpenSettings" controls:ButtonFx.IconEffect="SpinCW" WindowChrome.IsHitTestVisibleInChrome="True" Margin="2,0,0,0" Click="SettingsBtn_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                </Button>
            </StackPanel>

            <StackPanel x:Name="CaptionButtonsPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">

                <Button x:Name="MinimizeBtn" Style="{StaticResource CaptionBtn}" ToolTip="Minimize" Click="MinimizeBtn_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{DynamicResource PlayerPrimaryForegroundBrush}" />
                </Button>

                <Button x:Name="MaxRestoreBtn" Style="{StaticResource CaptionBtn}" ToolTip="Maximize" Click="MaxRestoreBtn_Click">
                    <TextBlock x:Name="MaxRestoreIcon" Text="" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{DynamicResource PlayerPrimaryForegroundBrush}" />
                </Button>

                <Button Style="{StaticResource CaptionCloseBtn}" Content="" ToolTip="Close" Click="CloseWindowBtn_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" x:Name="MediaWorkspace">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" x:Name="VideoGrid">

                <Rectangle x:Name="VideoBackdrop" Fill="Black" IsHitTestVisible="False" />

                <Grid x:Name="AmbientLayer" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
                    <Image x:Name="AmbientImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                                <GradientStop Color="#00000000" Offset="0.35" />
                                <GradientStop Color="#66000000" Offset="0.8" />
                                <GradientStop Color="#E0000000" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <Grid x:Name="VideoHostContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                    <Image x:Name="VideoImage" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="LowQuality" />
                </Grid>

                <Grid x:Name="VideoMouseOverlay" Background="Transparent" MouseDown="VideoOverlay_MouseDown" MouseLeftButtonDown="VideoOverlay_MouseLeftButtonDown" MouseMove="VideoOverlay_MouseMoveDrag" MouseWheel="VideoOverlay_MouseWheel" />

                <controls:AudioNowPlaying x:Name="AudioSurface" Visibility="Collapsed" />

                <Border x:Name="LockBadge" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" Padding="12,6,6,6" CornerRadius="18" Background="{StaticResource PopupSurfaceBrush}" BorderBrush="{StaticResource PopupBorderBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5" Panel.ZIndex="50">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LockBadgeScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="Black" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LockBadgeIcon" Text="" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#FF60CDFF" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform x:Name="LockIconRotate" /></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="LockBadgeText" Text="Controls locked" Margin="8,0,12,0" FontSize="12.5" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" />
                        <Button x:Name="LockBadgeUnlockBtn" Click="LockBadgeUnlock_Click" FontSize="12" Cursor="Hand" Foreground="White" Content="Unlock" ToolTip="Unlock controls">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="13" Padding="12,4" Background="#3360CDFF" BorderBrush="#6660CDFF" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#5560CDFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#7760CDFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="VolumeOsdAnchor" Width="1" Height="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,52,0,0" IsHitTestVisible="False" />
                <Border x:Name="PlaybackOsdAnchor" Width="1" Height="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

                <StackPanel x:Name="EmptyMediaState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <Grid Width="112" Height="112" HorizontalAlignment="Center">
                        <Ellipse Fill="{StaticResource AccentGradientBrush}" Opacity="0.22">
                            <Ellipse.Effect>
                                <BlurEffect Radius="28" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Border Width="84" Height="84" CornerRadius="42" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </Border>
                    </Grid>
                    <TextBlock Text="Drop files here" FontSize="18" FontWeight="SemiBold" Foreground="#E6FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0" />
                    <TextBlock Text="MKV · MP4 · AVI · WEBM · FLAC · MP3 · streams and more" FontSize="12" Foreground="#80FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Style="{StaticResource AccentButton}" Margin="4" Command="{Binding OpenFileCommand}" ToolTip="Ctrl+O">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Open file" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Height="34" Padding="14,0" Margin="4" Command="{Binding OpenUrlCommand}" ToolTip="Ctrl+U">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Open URL" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <Grid x:Name="OsdOverlay" VerticalAlignment="Bottom" Height="50" IsHitTestVisible="False" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#BB000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <ui:ProgressRing Width="48" Height="48" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVis}}" />

                <Border x:Name="ErrorBanner" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,60" Background="#E0CC3333" CornerRadius="10" Padding="16,8" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="ErrorText" FontSize="13" Foreground="White" TextWrapping="Wrap" MaxWidth="400" />
                </Border>

                <Border x:Name="FullscreenOsd" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="1200" Visibility="Collapsed" Opacity="0" IsHitTestVisible="True" Background="#D8121620" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="18" Padding="18,10,18,12" Margin="40,0,40,28">
                    <Border.Resources>
                        <ResourceDictionary Source="/FluxPlayer;component/Themes/DarkSurfacePalette.xaml" />
                    </Border.Resources>
                    <StackPanel>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CurrentTime}" FontSize="12" Foreground="#F2F2F2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                            <Grid Grid.Column="1">
                                <Slider x:Name="FsSeekBar" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="100" Value="{Binding SeekPosition, Mode=OneWay}" VerticalAlignment="Center" PreviewMouseLeftButtonDown="FsSeekBar_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="FsSeekBar_PreviewMouseLeftButtonUp" LostMouseCapture="FsSeekBar_LostMouseCapture" ValueChanged="FsSeekBar_ValueChanged" MouseMove="SeekBar_HoverMove" MouseLeave="SeekBar_HoverLeave" />
                                <Canvas x:Name="FsBookmarkCanvas" IsHitTestVisible="False" ClipToBounds="False" SizeChanged="BookmarkCanvas_SizeChanged" />
                                <Canvas IsHitTestVisible="False" ClipToBounds="False">
                                    <Border x:Name="FsSeekPreviewTip" Canvas.Top="-30" Padding="3" CornerRadius="8" Background="{StaticResource PopupSurfaceBrush}" BorderBrush="{StaticResource PopupBorderBrush}" BorderThickness="1" Visibility="Collapsed">
                                        <StackPanel>
                                            <Border x:Name="FsSeekThumbHost" CornerRadius="6" Background="#FF0B0D12" Visibility="Collapsed" ClipToBounds="True">
                                                <Image x:Name="FsSeekThumbImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <TextBlock x:Name="FsSeekPreviewText" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="6,2,6,1" Foreground="#F2F2F2" />
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding TotalTime}" FontSize="12" Foreground="#B0FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource TransportButton}" Margin="3,0" Command="{Binding PreviousCommand}" ToolTip="Previous" controls:HotkeyHint.Action="PreviousTrack" controls:ButtonFx.IconEffect="NudgeLeft">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                            </Button>
                            <Button Style="{StaticResource SeekGlyphButton}" Margin="3,0" Tag="-1" controls:ButtonFx.IconEffect="SpinCCW" controls:ButtonFx.KeyActions="SeekBackward|SeekBackwardLarge" Command="{Binding SeekBackwardCommand}">
                                <Button.ToolTip>
                                    <ToolTip Content="{Binding SeekStepSeconds}" ContentStringFormat="Seek backward {0} s" />
                                </Button.ToolTip>
                            </Button>
                            <Button Style="{StaticResource PlayButton}" Margin="8,0" Command="{Binding PlayPauseCommand}" controls:ButtonFx.KeyActions="PlayPause" ToolTip="{Binding IsPlaying, Converter={StaticResource PlayTooltip}}">
                                <controls:PlayPauseIcon IsPlaying="{Binding IsPlaying}" Width="20" Height="20" />
                            </Button>
                            <Button Style="{StaticResource SeekGlyphButton}" Margin="3,0" controls:ButtonFx.IconEffect="SpinCW" controls:ButtonFx.KeyActions="SeekForward|SeekForwardLarge" Command="{Binding SeekForwardCommand}">
                                <Button.ToolTip>
                                    <ToolTip Content="{Binding SeekStepSeconds}" ContentStringFormat="Seek forward {0} s" />
                                </Button.ToolTip>
                            </Button>
                            <Button Style="{StaticResource TransportButton}" Margin="3,0" Command="{Binding NextCommand}" ToolTip="Next" controls:HotkeyHint.Action="NextTrack" controls:ButtonFx.IconEffect="NudgeRight">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                            </Button>
                            <Rectangle Width="1" Height="20" Fill="#28FFFFFF" Margin="12,0" />
                            <Button Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="15" controls:ButtonFx.IconEffect="Wiggle" Command="{Binding ToggleMuteCommand}" ToolTip="Mute" controls:HotkeyHint.Action="ToggleMute">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding VolumeIcon}" />
                            </Button>
                            <Slider Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="{Binding MaxVolume}" Value="{Binding Volume}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <Rectangle Width="1" Height="20" Fill="#28FFFFFF" Margin="12,0" />
                            <Button x:Name="FsExitBtn" Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="15" ToolTip="Exit fullscreen (Esc)" controls:ButtonFx.KeyActions="ToggleFullscreen" Click="FullscreenBtn_Click">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="MediaInfoPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0" Background="#D0111111" CornerRadius="10" Padding="14,10" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock Text="Media information" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                        <TextBlock x:Name="MediaInfoText" FontSize="11.5" Foreground="#CCFFFFFF" TextWrapping="Wrap" MaxWidth="340" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="PlaylistPanel" Grid.Column="1" Width="288" Visibility="{Binding IsPlaylistVisible, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ChromeTintBrush}" BorderBrush="Transparent" BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,10,10,10" BorderBrush="Transparent" BorderThickness="0">
                        <Grid>
                            <TextBlock Text="Playlist" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PlayerPrimaryForegroundBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource TransportButton}" Width="30" Height="30" FontSize="13" ToolTip="Shuffle" controls:ButtonFx.IconEffect="Wiggle" Command="{Binding ToggleShuffleCommand}" Tag="{Binding Shuffle, Converter={StaticResource ActiveTag}}">
                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                                </Button>
                                <Button Style="{StaticResource TransportButton}" Width="30" Height="30" FontSize="13" Margin="2,0,0,0" ToolTip="Repeat (none / all / one)" controls:ButtonFx.IconEffect="SpinCW" Command="{Binding ToggleRepeatCommand}" Tag="{Binding RepeatMode, Converter={StaticResource ActiveTag}}">
                                    <TextBlock Text="{Binding RepeatMode, Converter={StaticResource RepeatIcon}}" FontFamily="Segoe Fluent Icons" />
                                </Button>
                                <Button Style="{StaticResource TransportButton}" Width="30" Height="30" FontSize="13" Margin="2,0,0,0" ToolTip="Clear playlist" controls:ButtonFx.IconEffect="Wiggle" Command="{Binding ClearPlaylistCommand}">
                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="PlaylistBox" ItemsSource="{Binding Playlist}" SelectedItem="{Binding CurrentItem, Mode=OneWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ItemContainerStyle="{StaticResource PlaylistItemStyle}" MouseDoubleClick="PlaylistBox_MouseDoubleClick" AllowDrop="True" PreviewMouseLeftButtonDown="PlaylistBox_PreviewMouseLeftButtonDown" PreviewMouseMove="PlaylistBox_PreviewMouseMove" DragOver="PlaylistBox_DragOver" DragLeave="PlaylistBox_DragLeave" Drop="PlaylistBox_Drop" PreviewMouseRightButtonDown="PlaylistBox_PreviewMouseRightButtonDown" ContextMenuService.IsEnabled="False" ContextMenuOpening="PlaylistBox_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="PlaylistItemMenu" MinWidth="230" Opened="PlaylistItemMenu_Opened">
                                <MenuItem x:Name="PlCtxPlay" Header="Play" Click="PlCtxPlay_Click">
                                    <MenuItem.Icon><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="PlCtxQueue" Header="Play next" Click="PlCtxQueue_Click">
                                    <MenuItem.Icon><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="PlCtxReveal" Header="Open file location" Click="PlCtxReveal_Click">
                                    <MenuItem.Icon><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="PlCtxCopy" Header="Copy path" Click="PlCtxCopy_Click">
                                    <MenuItem.Icon><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="PlCtxRemove" Header="Remove from playlist" Click="PlCtxRemove_Click">
                                    <MenuItem.Icon><TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TypeIcon" Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource PlayerSecondaryForegroundBrush}" VerticalAlignment="Center" />

                                        <StackPanel x:Name="PlayingBars" Orientation="Horizontal" Height="12" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Rectangle x:Name="Bar1" Width="3" Height="12" RadiusX="1" RadiusY="1" Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,1" Margin="0,0,2,0">
                                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.45" /></Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Rectangle x:Name="Bar2" Width="3" Height="12" RadiusX="1" RadiusY="1" Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,1" Margin="0,0,2,0">
                                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.9" /></Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Rectangle x:Name="Bar3" Width="3" Height="12" RadiusX="1" RadiusY="1" Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6" /></Rectangle.RenderTransform>
                                            </Rectangle>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                                        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource PlayerPrimaryForegroundBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding Duration}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource PlayerSecondaryForegroundBrush}" />
                                            <Border x:Name="QueueChip" Margin="8,0,0,0" Padding="6,0,7,1" CornerRadius="8" VerticalAlignment="Center" Background="{DynamicResource FxAccentSoftBrush}" BorderBrush="{DynamicResource FxAccentBorderBrush}" BorderThickness="1" ToolTip="Queued: plays next">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="9" VerticalAlignment="Center" Margin="0,1,4,0" Foreground="{DynamicResource FxAccentTextBrush}" />
                                                    <TextBlock FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource FxAccentTextBrush}">
                                                        <Run Text="Queue" /><Run Text=" · " /><Run Text="{Binding QueuePosition, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2" x:Name="RemoveBtn" Style="{StaticResource TransportButton}" Width="24" Height="24" FontSize="10" Opacity="0" ToolTip="Remove from playlist" Command="{Binding DataContext.RemoveFromPlaylistCommand,                                                       RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                        <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding QueuePosition}" Value="0">
                                        <Setter TargetName="QueueChip" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver,                                                  RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="RemoveBtn" Property="Opacity" Value="0.85" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter TargetName="TypeIcon" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="PlayingBars" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource FxAccentTextBrush}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPlaying}" Value="True" />
                                            <Condition Binding="{Binding DataContext.IsPlaying,                                                        RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="BarsAnim">

                                                <Storyboard Timeline.DesiredFrameRate="24">
                                                    <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.3" To="1" Duration="0:0:0.42" AutoReverse="True" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.25" Duration="0:0:0.36" AutoReverse="True" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.5" To="0.95" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="BarsAnim" />
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" IsHitTestVisible="False" Visibility="{Binding Playlist.Count, Converter={StaticResource ZeroToVisible}}">
                        <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="30" HorizontalAlignment="Center" Opacity="0.35" Foreground="{DynamicResource PlayerPrimaryForegroundBrush}" />
                        <TextBlock Text="The playlist is empty" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,2" Foreground="{DynamicResource PlayerPrimaryForegroundBrush}" Opacity="0.75" />
                        <TextBlock Text="Drop files here" FontSize="11.5" HorizontalAlignment="Center" Foreground="{DynamicResource PlayerSecondaryForegroundBrush}" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="10,6,10,10">
                        <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Command="{Binding OpenFileCommand}" ToolTip="Add files" controls:HotkeyHint.Action="OpenFile">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Add files" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <UniformGrid Rows="1" Margin="-3,6,-3,0">
                            <Button Style="{StaticResource ChipButton}" Height="30" Margin="3,0" Padding="6,0" HorizontalAlignment="Stretch" Click="RecentFilesBtn_Click" ToolTip="Recent files">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PlRecentLabel" Text="Recent" VerticalAlignment="Center" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipButton}" Height="30" Margin="3,0" Padding="6,0" HorizontalAlignment="Stretch" Command="{Binding OpenPlaylistFileCommand}" ToolTip="Open playlist (.m3u / .pls)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PlOpenLabel" Text="Open" VerticalAlignment="Center" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipButton}" Height="30" Margin="3,0" Padding="6,0" HorizontalAlignment="Stretch" Command="{Binding SavePlaylistFileCommand}" ToolTip="Save playlist as .m3u">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PlSaveLabel" Text="Save" VerticalAlignment="Center" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="ControlBar" Grid.Row="2" Background="{DynamicResource ChromeTintBrush}" BorderBrush="Transparent" BorderThickness="0" Padding="12,6,12,10">
            <StackPanel>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="50" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding CurrentTime}" FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource PlayerPrimaryForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />

                    <Grid Grid.Column="1">
                        <Slider x:Name="SeekBar" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="100" Value="{Binding SeekPosition, Mode=OneWay}" VerticalAlignment="Center" IsEnabled="{Binding HasMedia}" PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp" LostMouseCapture="SeekBar_LostMouseCapture" ValueChanged="SeekBar_ValueChanged" MouseMove="SeekBar_HoverMove" MouseLeave="SeekBar_HoverLeave" />

                        <Canvas x:Name="BookmarkCanvas" IsHitTestVisible="False" ClipToBounds="False" SizeChanged="BookmarkCanvas_SizeChanged" />

                        <Canvas IsHitTestVisible="False" ClipToBounds="False">
                            <Border x:Name="SeekPreviewTip" Canvas.Top="-30" Padding="3" CornerRadius="8" Background="{StaticResource PopupSurfaceBrush}" BorderBrush="{StaticResource PopupBorderBrush}" BorderThickness="1" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="Black" />
                                </Border.Effect>
                                <StackPanel>
                                    <Border x:Name="SeekThumbHost" CornerRadius="6" Background="#FF0B0D12" Visibility="Collapsed" ClipToBounds="True">
                                        <Image x:Name="SeekThumbImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock x:Name="SeekPreviewText" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="6,2,6,1" Foreground="#F2F2F2" />
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>

                    <TextBlock Grid.Column="2" Text="{Binding TotalTime}" FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource PlayerSecondaryForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <Grid x:Name="ControlRow" SizeChanged="ControlRow_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="LeftControls" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" ClipToBounds="True">

                        <Button Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="15" controls:ButtonFx.IconEffect="Wiggle" Command="{Binding ToggleMuteCommand}" ToolTip="Mute" controls:HotkeyHint.Action="ToggleMute">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding VolumeIcon}" />
                        </Button>

                        <Slider x:Name="VolumeBar" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="{Binding MaxVolume}" Value="{Binding Volume}" VerticalAlignment="Center" Margin="2,0,0,0">
                            <Slider.ToolTip>
                                <ToolTip Content="{Binding Volume}" ContentStringFormat="Volume: {0:0}%" />
                            </Slider.ToolTip>
                        </Slider>

                        <StackPanel x:Name="LeftAudioGroup" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="1" Height="20" Fill="{DynamicResource PlayerSeparatorBrush}" Margin="10,0,8,0" />
                            <ComboBox x:Name="AudioCombo" Width="124" Height="32" FontSize="12" VerticalContentAlignment="Center" ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack}" ItemTemplate="{StaticResource TrimmedTrackItem}" ToolTip="Audio track" IsEnabled="{Binding HasMedia}" />
                        </StackPanel>

                        <StackPanel x:Name="LeftSpeedGroup" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="1" Height="20" Fill="{DynamicResource PlayerSeparatorBrush}" Margin="10,0,8,0" />
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource PlayerSecondaryForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="SpeedCombo" Width="84" Height="32" FontSize="12" VerticalContentAlignment="Center" ToolTip="Playback speed" controls:HotkeyHint.Action="SpeedDown|SpeedUp" SelectionChanged="SpeedCombo_SelectionChanged">
                                <ComboBoxItem Content="0.25x" Tag="0.25" />
                                <ComboBoxItem Content="0.5x" Tag="0.5" />
                                <ComboBoxItem Content="0.75x" Tag="0.75" />
                                <ComboBoxItem Content="1x" Tag="1.0" />
                                <ComboBoxItem Content="1.25x" Tag="1.25" />
                                <ComboBoxItem Content="1.5x" Tag="1.5" />
                                <ComboBoxItem Content="1.75x" Tag="1.75" />
                                <ComboBoxItem Content="2x" Tag="2.0" />
                                <ComboBoxItem Content="3x" Tag="3.0" />
                                <ComboBoxItem Content="4x" Tag="4.0" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="CenterControls" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">

                        <Button Style="{StaticResource TransportButton}" Margin="2,0" Command="{Binding PreviousCommand}" ToolTip="Previous" controls:HotkeyHint.Action="PreviousTrack" controls:ButtonFx.IconEffect="NudgeLeft">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                        </Button>
                        <Button x:Name="SeekBackBtn" Style="{StaticResource SeekGlyphButton}" Margin="2,0" Tag="-1" controls:ButtonFx.IconEffect="SpinCCW" controls:ButtonFx.KeyActions="SeekBackward|SeekBackwardLarge" Command="{Binding SeekBackwardCommand}">
                            <Button.ToolTip>
                                <ToolTip Content="{Binding SeekStepSeconds}" ContentStringFormat="Seek backward {0} s" />
                            </Button.ToolTip>
                        </Button>
                        <Button Style="{StaticResource PlayButton}" Margin="8,0" Command="{Binding PlayPauseCommand}" controls:ButtonFx.KeyActions="PlayPause" ToolTip="{Binding IsPlaying, Converter={StaticResource PlayTooltip}}">
                            <controls:PlayPauseIcon IsPlaying="{Binding IsPlaying}" Width="20" Height="20" />
                        </Button>
                        <Button x:Name="SeekFwdBtn" Style="{StaticResource SeekGlyphButton}" Margin="2,0" controls:ButtonFx.IconEffect="SpinCW" controls:ButtonFx.KeyActions="SeekForward|SeekForwardLarge" Command="{Binding SeekForwardCommand}">
                            <Button.ToolTip>
                                <ToolTip Content="{Binding SeekStepSeconds}" ContentStringFormat="Seek forward {0} s" />
                            </Button.ToolTip>
                        </Button>
                        <Button Style="{StaticResource TransportButton}" Margin="2,0" controls:ButtonFx.IconEffect="NudgeRight" Command="{Binding NextCommand}" ToolTip="Next" controls:HotkeyHint.Action="NextTrack">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="RightControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True">

                        <StackPanel x:Name="ToolbarTier4" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="SubtitleCombo" Width="148" Height="32" FontSize="12" Margin="0,0,4,0" VerticalContentAlignment="Center" ItemsSource="{Binding SubtitleTracks}" SelectedItem="{Binding SelectedSubtitleTrack}" ItemTemplate="{StaticResource TrimmedTrackItem}" ToolTip="Subtitles" IsEnabled="{Binding HasMedia}" />

                            <Button Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="15" Command="{Binding LoadSubtitleFileCommand}" ToolTip="Load external subtitle (.srt / .ass)" controls:ButtonFx.IconEffect="Bounce" IsEnabled="{Binding HasMedia}">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                            </Button>

                            <Rectangle Width="1" Height="20" Fill="{DynamicResource PlayerSeparatorBrush}" Margin="6,0" />
                        </StackPanel>

                        <StackPanel x:Name="ToolbarTier3" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="AspectCombo" Width="92" Height="32" FontSize="12" Margin="0,0,4,0" VerticalContentAlignment="Center" ToolTip="Aspect ratio" SelectionChanged="AspectCombo_SelectionChanged">
                                <ComboBoxItem Content="Auto" Tag="Auto" IsSelected="True" />
                                <ComboBoxItem Content="16:9" Tag="16:9" />
                                <ComboBoxItem Content="4:3" Tag="4:3" />
                                <ComboBoxItem Content="21:9" Tag="21:9" />
                                <ComboBoxItem Content="1:1" Tag="1:1" />
                                <ComboBoxItem Content="Stretch" Tag="Stretch" />
                            </ComboBox>

                            <Button Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="15" ToolTip="Media information" controls:HotkeyHint.Action="ToggleMediaInfo" Click="MediaInfoBtn_Click" IsEnabled="{Binding HasMedia}">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                            </Button>

                            <Button x:Name="EqualizerBtn" Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="15" ToolTip="Equalizer" controls:HotkeyHint.Action="ToggleEqualizer" controls:ButtonFx.IconEffect="Bounce" Tag="{Binding IsEqualizerEnabled, Converter={StaticResource ActiveTag}}" Click="EqualizerBtn_Click">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                            </Button>

                            <Rectangle Width="1" Height="20" Fill="{DynamicResource PlayerSeparatorBrush}" Margin="6,0" />
                        </StackPanel>

                        <StackPanel x:Name="ToolbarTier2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ChipButton}" MinWidth="58" Margin="0,0,4,0" Command="{Binding ToggleAbLoopCommand}" ToolTip="A-B loop: mark A, then B, then press again to clear" controls:HotkeyHint.Action="ToggleAbLoop" Tag="{Binding AbLoopStage, Converter={StaticResource ActiveTag}}" IsEnabled="{Binding HasMedia}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding AbLoopLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="15" Command="{Binding FrameForwardCommand}" ToolTip="Advance one frame" controls:HotkeyHint.Action="FrameForward" controls:ButtonFx.IconEffect="NudgeRight" IsEnabled="{Binding HasMedia}">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                            </Button>

                            <Button x:Name="AvSyncBtn" Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="15" ToolTip="Audio and subtitle synchronization" controls:ButtonFx.IconEffect="Wiggle" Tag="{Binding HasAvOffset, Converter={StaticResource ActiveTag}}" Click="AvSyncBtn_Click" IsEnabled="{Binding HasMedia}">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                            </Button>

                            <Rectangle Width="1" Height="20" Fill="{DynamicResource PlayerSeparatorBrush}" Margin="6,0" />
                        </StackPanel>

                        <StackPanel x:Name="ToolbarTier1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SnapshotButton" Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="15" Command="{Binding TakeSnapshotCommand}" ToolTip="Take snapshot" controls:HotkeyHint.Action="TakeSnapshot" controls:ButtonFx.IconEffect="Snap" IsEnabled="{Binding HasMedia}">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                            </Button>

                            <Button Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="15" ToolTip="Mini player" controls:HotkeyHint.Action="MiniPlayer" Click="MiniPlayerBtn_Click" IsEnabled="{Binding HasMedia}">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                            </Button>
                        </StackPanel>

                        <Button x:Name="ToolbarMoreBtn" Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="16" Visibility="Collapsed" ToolTip="More options" Click="ToolbarMoreBtn_Click">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                        </Button>

                        <Button x:Name="FullscreenBtn" Style="{StaticResource TransportButton}" Width="36" Height="36" FontSize="15" ToolTip="Fullscreen" controls:HotkeyHint.Action="ToggleFullscreen" Click="FullscreenBtn_Click">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Popup x:Name="AvSyncPopup" PlacementTarget="{Binding ElementName=AvSyncBtn}" Placement="Custom" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False" Grid.Row="2">
            <Border Style="{StaticResource PopupSurface}" Width="300" Margin="12">
                <StackPanel>
                    <TextBlock Text="Synchronization" FontSize="14" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MinWidth="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Audio" FontSize="12.5" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ChipButton}" Width="32" Padding="0" Command="{Binding DecreaseAudioDelayCommand}" ToolTip="Advance audio">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="10" />
                        </Button>
                        <TextBlock Grid.Column="2" Text="{Binding AudioDelayMs, StringFormat={}{0:+0;-0;0} ms}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" TextAlignment="Center" />
                        <Button Grid.Column="3" Style="{StaticResource ChipButton}" Width="32" Padding="0" Command="{Binding IncreaseAudioDelayCommand}" ToolTip="Delay audio">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="10" />
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource TransportButton}" Width="32" Height="32" FontSize="12" Margin="4,0,0,0" Command="{Binding ResetAudioDelayCommand}" ToolTip="Reset">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MinWidth="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Subtitles" FontSize="12.5" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ChipButton}" Width="32" Padding="0" Command="{Binding DecreaseSubtitleDelayCommand}" ToolTip="Advance subtitles" controls:HotkeyHint.Action="SubtitleDelayMinus">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="10" />
                        </Button>
                        <TextBlock Grid.Column="2" Text="{Binding SubtitleDelayMs, StringFormat={}{0:+0;-0;0} ms}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" TextAlignment="Center" />
                        <Button Grid.Column="3" Style="{StaticResource ChipButton}" Width="32" Padding="0" Command="{Binding IncreaseSubtitleDelayCommand}" ToolTip="Delay subtitles" controls:HotkeyHint.Action="SubtitleDelayPlus">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="10" />
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource TransportButton}" Width="32" Height="32" FontSize="12" Margin="4,0,0,0" Command="{Binding ResetSubtitleDelayCommand}" ToolTip="Reset">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" />
                        </Button>
                    </Grid>

                    <TextBlock Text="Positive values delay the track relative to the video." FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="RecentFilesPopup" PlacementTarget="{Binding ElementName=PlaylistPanel}" Placement="Center" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
            <Border Style="{StaticResource PopupSurface}" Padding="14,12" Width="300" MaxHeight="420">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Recent files" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        <Button Style="{StaticResource TransportButton}" Width="24" Height="24" HorizontalAlignment="Right" Command="{Binding ClearRecentFilesCommand}" ToolTip="Clear recent list">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="11" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RecentFilesList}" MaxHeight="280">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipButton}" Background="Transparent" BorderThickness="0" Height="Auto" Margin="0,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" FontWeight="Normal" Command="{Binding DataContext.OpenRecentFileCommand,                                                   RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Converter={StaticResource PathToFileName}}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PlayerPrimaryForegroundBrush}" />
                                        <TextBlock Text="{Binding}" FontSize="10" Opacity="0.45" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PlayerSecondaryForegroundBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ToolbarMorePopup" PlacementTarget="{Binding ElementName=ToolbarMoreBtn}" Placement="Custom" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False" Grid.Row="2">
            <Border Style="{StaticResource PopupSurface}" Padding="6">
                <StackPanel x:Name="ToolbarMorePanel" MinWidth="220">

                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="PlaybackOsdPopup" PlacementTarget="{Binding ElementName=PlaybackOsdAnchor}" Placement="Center" AllowsTransparency="True" StaysOpen="True" IsHitTestVisible="False" Focusable="False" Grid.Row="1">
            <Border x:Name="PlaybackOsdRoot" MinWidth="200" Padding="22,16" Margin="24" CornerRadius="18" BorderThickness="0" Opacity="0">
                <Border.Background>
                    <SolidColorBrush Color="#F01B1F2A" />
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#1A60CDFF" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="PlaybackOsdIcon" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#60CDFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="PlaybackOsdText" FontSize="17" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="VolumeOsdPopup" PlacementTarget="{Binding ElementName=VolumeOsdAnchor}" Placement="Center" AllowsTransparency="True" StaysOpen="True" IsHitTestVisible="False" Focusable="False" Grid.Row="1">
            <Border x:Name="VolumeOsdRoot" MinWidth="240" Padding="18,12" Margin="22" CornerRadius="16" BorderThickness="0" Opacity="0">
                <Border.Background>
                    <SolidColorBrush Color="#F01B1F2A" />
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.55" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="VolumeOsdIcon" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#60CDFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock x:Name="VolumeOsdText" FontSize="15" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" MinWidth="48" />
                    </StackPanel>

                    <Grid Height="6" VerticalAlignment="Center">
                        <Border CornerRadius="3" Background="#22FFFFFF" />
                        <Border x:Name="VolumeOsdBar" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#60CDFF" Offset="0" />
                                    <GradientStop Color="#A66DFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</ui:FluentWindow>
