                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding BilingualText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock Text="{Binding BilingualText}" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Segoe UI" FontSize="24" Foreground="White"/>
                    </Border>
                </Grid>

                <Grid x:Name="VideoMouseOverlay" Background="Transparent" MouseDown="VideoOverlay_MouseDown" MouseLeftButtonDown="VideoOverlay_MouseLeftButtonDown" MouseLeftButtonUp="VideoOverlay_MouseLeftButtonUp" LostMouseCapture="VideoOverlay_LostMouseCapture" MouseMove="VideoOverlay_MouseMoveDrag" MouseWheel="VideoOverlay_MouseWheel" />

