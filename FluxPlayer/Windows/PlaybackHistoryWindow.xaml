<ui:FluentWindow x:Class="FluxPlayer.Windows.PlaybackHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Playback history · FluxPlayer" Width="1060" Height="700" MinWidth="820" MinHeight="560" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" WindowBackdropType="Mica" Background="Transparent">
 <Grid Margin="24,18,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="Playback history" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="RecordingNote" Text="Recording is controlled in Settings > Library. Records describe sessions, not complete listens." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="Search" Padding="10,7" TextChanged="Search_Changed" AutomationProperties.Name="Search playback history" ToolTip="Search title, artist or recorded path"/>
   <ComboBox x:Name="Kind" Grid.Column="1" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Kind_Changed" AutomationProperties.Name="History media type"><ComboBoxItem Content="All media"/><ComboBoxItem Content="Audio"/><ComboBoxItem Content="Video"/></ComboBox>
   <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" Padding="14,7" Margin="10,0,0,0"/>
  </Grid>
  <DataGrid x:Name="Sessions" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="38" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="Resume_Click" AutomationProperties.Name="Recorded playback sessions">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Started (UTC)" Binding="{Binding StartedUtc.UtcDateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" MinWidth="140"/>
    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" MinWidth="100"/>
    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="70"/>
    <DataGridTextColumn Header="Listened" Binding="{Binding Listened}" SortMemberPath="PlayedMs" Width="90"/>
    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" SortMemberPath="DurationMs" Width="90"/>
    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="95"/>
   </DataGrid.Columns>
   <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGrid.RowStyle>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,14,0,0"><WrapPanel x:Name="Actions"><Button Content="Play from start" Click="Play_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Resume selected" Click="Resume_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Export view copy…" Click="Export_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Clear all history…" Click="Clear_Click" Padding="14,8" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock x:Name="Status" Text="Loading recorded sessions…" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
  </StackPanel>
 </Grid>
</ui:FluentWindow>
