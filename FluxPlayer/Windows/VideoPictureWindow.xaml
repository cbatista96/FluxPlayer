<ui:FluentWindow x:Class="FluxPlayer.Windows.VideoPictureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Video picture · FluxPlayer" Width="820" Height="720" MinWidth="740" MinHeight="650" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" WindowBackdropType="Mica" Background="Transparent">
 <Grid Margin="24,18,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <StackPanel x:Name="CropPanel">
    <TextBlock x:Name="SourceSize" FontSize="18" Margin="0,0,0,16"/>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,12,16"><TextBlock Text="Left (pixels)" Margin="0,0,0,6"/><TextBox x:Name="CropLeft" Text="0" Padding="10,7" AutomationProperties.Name="Crop left"/></StackPanel><StackPanel Margin="0,0,0,16"><TextBlock Text="Top (pixels)" Margin="0,0,0,6"/><TextBox x:Name="CropTop" Text="0" Padding="10,7" AutomationProperties.Name="Crop top"/></StackPanel><StackPanel Margin="0,0,12,16"><TextBlock Text="Width (pixels)" Margin="0,0,0,6"/><TextBox x:Name="CropWidth" Padding="10,7" AutomationProperties.Name="Crop width"/></StackPanel><StackPanel Margin="0,0,0,16"><TextBlock Text="Height (pixels)" Margin="0,0,0,6"/><TextBox x:Name="CropHeight" Padding="10,7" AutomationProperties.Name="Crop height"/></StackPanel></UniformGrid>
    <WrapPanel><Button Content="Apply crop" Click="CropApply_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Reset crop" Click="CropReset_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Read current video size" Click="ReadSize_Click" Padding="14,8" Margin="0,0,0,8"/></WrapPanel>
    <TextBlock Text="The crop applies to the current source only and resets when another source opens. Coordinates refer to the decoded source picture." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
   <StackPanel x:Name="PresetsPanel">
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Saved preset" Margin="0,0,0,6"/><ComboBox x:Name="Presets" SelectionChanged="Preset_Changed" AutomationProperties.Name="Saved picture preset"/></StackPanel><Button Grid.Column="1" Content="Use selected" Click="Use_Click" VerticalAlignment="Bottom" Padding="14,8" Margin="12,0,0,0"/></Grid>
    <TextBlock Text="Preset name" Margin="0,0,0,6"/><TextBox x:Name="PresetName" MaxLength="80" Padding="10,7" Margin="0,0,0,16" AutomationProperties.Name="Picture preset name"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="Brightness" VerticalAlignment="Center"/><Slider x:Name="Brightness" Grid.Column="1" Minimum="0" Maximum="2" Value="1" SmallChange="0.05" AutomationProperties.Name="Picture brightness"/><TextBlock Grid.Column="2" Text="{Binding ElementName=Brightness, Path=Value, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="Contrast" VerticalAlignment="Center"/><Slider x:Name="Contrast" Grid.Column="1" Minimum="0" Maximum="2" Value="1" SmallChange="0.05" AutomationProperties.Name="Picture contrast"/><TextBlock Grid.Column="2" Text="{Binding ElementName=Contrast, Path=Value, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="Saturation" VerticalAlignment="Center"/><Slider x:Name="Saturation" Grid.Column="1" Minimum="0" Maximum="2" Value="1" SmallChange="0.05" AutomationProperties.Name="Picture saturation"/><TextBlock Grid.Column="2" Text="{Binding ElementName=Saturation, Path=Value, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="Hue" VerticalAlignment="Center"/><Slider x:Name="Hue" Grid.Column="1" Minimum="0" Maximum="360" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" AutomationProperties.Name="Picture hue"/><TextBlock Grid.Column="2" Text="{Binding ElementName=Hue, Path=Value, StringFormat={}{0:0}°}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Margin="0,12,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="Gamma" VerticalAlignment="Center"/><Slider x:Name="Gamma" Grid.Column="1" Minimum="0.1" Maximum="2" Value="1" SmallChange="0.05" AutomationProperties.Name="Picture gamma"/><TextBlock Grid.Column="2" Text="{Binding ElementName=Gamma, Path=Value, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <WrapPanel><Button Content="Preview" Click="Preview_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Save and use" Click="Save_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Neutral picture" Click="Neutral_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Remove preset…" Click="Remove_Click" Padding="14,8" Margin="0,0,0,8"/></WrapPanel>
   </StackPanel>
  </StackPanel></ScrollViewer>
  <TextBlock x:Name="Status" Grid.Row="2" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
 </Grid>
</ui:FluentWindow>
