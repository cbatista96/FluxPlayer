<ui:FluentWindow x:Class="FluxPlayer.Windows.MediaCatalogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Saved media · FluxPlayer" Width="1120" Height="760" MinWidth="940" MinHeight="660" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" WindowBackdropType="Mica" Background="Transparent">
 <ui:FluentWindow.Resources>
  <Style TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Surface" CornerRadius="6" Background="Transparent" Padding="12,10" Margin="0,2"><Grid>
     <Border x:Name="Marker" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-8,0,0,0" Background="{DynamicResource FxAccentTextBrush}" Visibility="Collapsed"/>
     <ContentPresenter/>
    </Grid></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource FxHoverBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource FxAccentSoftBrush}"/><Setter TargetName="Marker" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource FxAccentTextBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FxAccentTextBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ui:FluentWindow.Resources>
 <Grid x:Name="Body" Margin="24,18,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Search" Margin="0,0,0,5"/><ui:TextBox PlaceholderText="Search saved media" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" x:Name="Search" TextChanged="Search_Changed" Padding="10,7" AutomationProperties.Name="Search saved media"/></StackPanel>
   <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0"><Button x:Name="NewButton" Content="New…" Click="New_Click" Padding="14,8" Margin="0,0,8,0"/><Button Content="Import playlist…" Click="Import_Click" Padding="14,8" Margin="0,0,8,0"/><Button Content="Refresh" Click="Refresh_Click" Padding="14,8"/></WrapPanel>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,16,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <CheckBox x:Name="FavoritesOnly" Content="Favorites only" Checked="FavoriteFilter_Changed" Unchecked="FavoriteFilter_Changed" Margin="0,0,0,10"/>
    <ListBox x:Name="CatalogList" Grid.Row="1" SelectionChanged="Selection_Changed" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Saved lists or stations">
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,12"><TextBlock Text="Name" Margin="0,0,0,5"/><TextBox x:Name="NameInput" MaxLength="120" Padding="10,7" AutomationProperties.Name="Saved media name"/></StackPanel>
     <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,12"><Button x:Name="SaveButton" Content="Save name" Click="Save_Click" Padding="14,8"/><Button x:Name="ProtectButton" Content="Lock playlist" Click="Protect_Click" Padding="14,8" Margin="8,0,0,0"/></WrapPanel>
    </Grid>
    <StackPanel x:Name="RadioFields" Grid.Row="1" Margin="0,0,0,12">
     <TextBlock Text="Stream address (HTTP, HTTPS, RTSP or MMS)" Margin="0,0,0,5"/><TextBox x:Name="UrlInput" MaxLength="8192" Padding="10,7" AutomationProperties.Name="Station stream URL"/>
     <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><TextBlock Text="Genre" Margin="0,0,0,5"/><TextBox x:Name="GenreInput" MaxLength="120" Padding="10,7"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Country or region" Margin="0,0,0,5"/><TextBox x:Name="CountryInput" MaxLength="120" Padding="10,7"/></StackPanel>
      <CheckBox x:Name="StationFavorite" Grid.Column="2" Content="Favorite" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
     </Grid>
    </StackPanel>
    <StackPanel x:Name="PlaylistActions" Grid.Row="1" Margin="0,0,0,10">
     <WrapPanel><Button Content="Append current queue" Click="AppendQueue_Click" Padding="12,7" Margin="0,0,8,8"/><Button Content="Add files…" Click="AddFiles_Click" Padding="12,7" Margin="0,0,8,8"/><Button Content="Remove selected entries" Click="RemoveTracks_Click" Padding="12,7" Margin="0,0,0,8"/></WrapPanel>
     <WrapPanel><Button Content="Move up" Click="Up_Click" Padding="12,7" Margin="0,0,8,8"/><Button Content="Move down" Click="Down_Click" Padding="12,7" Margin="0,0,8,8"/><Button Content="Sort by title" Click="Sort_Click" Padding="12,7" Margin="0,0,8,8"/><Button Content="Remove exact duplicates" Click="Deduplicate_Click" Padding="12,7" Margin="0,0,0,8"/></WrapPanel>
    </StackPanel>
    <DataGrid x:Name="Tracks" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="None" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" RowHeight="36" MouseDoubleClick="Play_Click">
     <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="50"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" MinWidth="120"/><DataGridTextColumn Header="Path or stream" Binding="{Binding Path}" Width="2*" MinWidth="160"/></DataGrid.Columns>
    </DataGrid>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,16,0,0"><WrapPanel><Button Content="Play selected" Click="Play_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Add to playback queue" Click="Enqueue_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Export new playlist copy…" Click="Export_Click" Padding="14,8" Margin="0,0,8,8"/><Button x:Name="RemoveButton" Content="Remove saved item…" Click="Remove_Click" Padding="14,8" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock x:Name="Status" Text="Loading…" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
  </StackPanel>
 </Grid>
</ui:FluentWindow>
