<ui:FluentWindow x:Class="FluxPlayer.Windows.MiniPlayerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:FluxPlayer.Controls" Title="FluxPlayer Mini" Height="200" Width="356" MinHeight="160" MinWidth="280" MaxHeight="600" MaxWidth="900" Topmost="True" ResizeMode="CanResize" WindowStyle="None" WindowBackdropType="None" ExtendsContentIntoTitleBar="True" Background="Black" MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseMove="Window_MouseMove" MouseLeave="Window_MouseLeave" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>

        <Rectangle Fill="Black" IsHitTestVisible="False" />

        <Image x:Name="MiniVideoImage" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="LowQuality" />

        <Border Margin="12,42,12,92" Padding="12" CornerRadius="8" Background="{DynamicResource FxCardBrush}" Visibility="{Binding IsAudioMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Width="64" Height="64">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="White" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding AlbumArtwork}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NowPlayingTitle}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding NowPlayingArtist}" FontSize="11" Margin="0,5,0,0" Foreground="#BFFFFFFF" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ControlsOverlay" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B0000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <DockPanel Grid.Row="0" Margin="12,4,4,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TransportButton}" Width="30" Height="30" FontSize="12" ToolTip="Return to the player (double-click)" Click="RestoreBtn_Click"></Button>
                    <Button Style="{StaticResource TransportButton}" Width="30" Height="30" FontSize="11" ToolTip="Close mini player" Click="CloseMiniBtn_Click"></Button>
                </StackPanel>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.92" />
            </DockPanel>

            <Border Grid.Row="2" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#C8000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel Grid.Row="2" Margin="12,14,12,6">
                <Grid Margin="2,0,2,0">
                    <TextBlock x:Name="TimeText" Foreground="#D0FFFFFF" FontSize="11" HorizontalAlignment="Left" />
                    <TextBlock x:Name="DurationText" Foreground="#A0FFFFFF" FontSize="11" HorizontalAlignment="Right" />
                </Grid>

                <Grid x:Name="ProgressHost" Height="14" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Progress_MouseLeftButtonDown" MouseEnter="Progress_MouseEnter" MouseLeave="Progress_MouseLeave" SizeChanged="ProgressHost_SizeChanged">
                    <Border x:Name="ProgressTrack" Height="3" CornerRadius="2" VerticalAlignment="Center" Background="#40FFFFFF" />
                    <Border x:Name="ProgressFill" Height="3" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentGradientHorizontalBrush}" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Button x:Name="PrevBtn" Style="{StaticResource TransportButton}" Width="34" Height="34" FontSize="14" ToolTip="Previous" controls:ButtonFx.IconEffect="NudgeLeft" Click="PrevBtn_Click"></Button>
                        <Button x:Name="PlayBtn" Style="{StaticResource PlayButton}" Width="40" Height="40" FontSize="16" Margin="6,0" ToolTip="Play / pause (Space)" Click="PlayBtn_Click">
                            <controls:PlayPauseIcon x:Name="PlayIcon" Width="18" Height="18" />
                        </Button>
                        <Button x:Name="NextBtn" Style="{StaticResource TransportButton}" Width="34" Height="34" FontSize="14" ToolTip="Next" controls:ButtonFx.IconEffect="NudgeRight" Click="NextBtn_Click"></Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.4" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="White" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</ui:FluentWindow>
