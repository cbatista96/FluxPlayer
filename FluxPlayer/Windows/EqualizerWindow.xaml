<ui:FluentWindow x:Class="FluxPlayer.Windows.EqualizerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Equalizer — FluxPlayer" Width="660" MinHeight="0" SizeToContent="Height" WindowStartupLocation="Manual" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True" PreviewKeyDown="Window_PreviewKeyDown">

    <ui:FluentWindow.Resources>
        <Style x:Key="EqChip" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Height" Value="32" />
        </Style>

        <Style x:Key="EqRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EqSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="1" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="0.5" />
            <Setter Property="Width" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Width="4" CornerRadius="2" Margin="0,9" HorizontalAlignment="Center" Background="{DynamicResource FxDividerBrush}" />
                            <Track x:Name="PART_Track" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource EqRepeat}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource EqRepeat}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="ks" ScaleX="1" ScaleY="1" />
                                                    </Grid.RenderTransform>
                                                    <Ellipse Fill="{DynamicResource FxAccentTextBrush}" />
                                                    <Ellipse Margin="4" Fill="{DynamicResource ApplicationBackgroundBrush}" />
                                                    <Ellipse x:Name="core" Margin="6" Fill="{DynamicResource FxAccentTextBrush}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ks" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0:0:0.14" />
                                                                    <DoubleAnimation Storyboard.TargetName="ks" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.14" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ks" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                                                                    <DoubleAnimation Storyboard.TargetName="ks" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="core" Property="Margin" Value="3" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="44" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{DynamicResource FxAccentTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Equalizer" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="  ·  10 bands + preamplifier" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:ToggleSwitch x:Name="EnableSwitch" VerticalAlignment="Center" Margin="0,0,10,0" OnContent="Enabled" OffContent="Off" Checked="EnableSwitch_Changed" Unchecked="EnableSwitch_Changed" />
                <Button Style="{StaticResource CaptionCloseBtn}" Height="44" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="" ToolTip="Close (Esc)" Click="CloseBtn_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,4,20,18">

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Preset" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="PresetCombo" Width="220" Height="32" FontSize="12.5" VerticalContentAlignment="Center" MaxDropDownHeight="360" SelectionChanged="PresetCombo_SelectionChanged" />
                    <Button Style="{StaticResource EqChip}" Margin="8,0,0,0" ToolTip="Previous preset" Click="PrevPreset_Click" Padding="9,0">
                        <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource EqChip}" Margin="4,0,0,0" ToolTip="Next preset" Click="NextPreset_Click" Padding="9,0">
                        <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="11" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="AntiClipCheck" Content="Compensate gain" FontSize="12" MinWidth="0" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Reduce the preamplifier by the largest band boost. This is not a peak limiter." Checked="AntiClip_Changed" Unchecked="AntiClip_Changed" />
                    <Button Style="{StaticResource EqChip}" ToolTip="Reset to flat" Click="Reset_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Reset" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border CornerRadius="10" Padding="12,12,14,8" Background="{DynamicResource FxCardBrush}" BorderBrush="{DynamicResource FxCardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="200" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>

                    <Canvas x:Name="ScaleCanvas" Grid.Row="1" Grid.Column="0" ClipToBounds="False" />
                    <Canvas x:Name="GridCanvas" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" IsHitTestVisible="False" />

                    <TextBlock x:Name="PreampValue" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Text="0.0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Slider x:Name="PreampSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource EqSlider}" ToolTip="Requested preamp (double-click: 0 dB). Effective gain is capped at +7.96 dB by the native engine and may be reduced by peak compensation." ValueChanged="PreampSlider_ValueChanged" MouseDoubleClick="PreampSlider_MouseDoubleClick" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="PRE" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource FxAccentTextBrush}" />
                    <Rectangle Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Width="1" HorizontalAlignment="Center" Fill="{DynamicResource FxDividerBrush}" />

                    <Canvas x:Name="CurveCanvas" Grid.Row="1" Grid.Column="3" IsHitTestVisible="False">
                        <Path x:Name="CurveFill" Opacity="0.22">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="{DynamicResource FxAccentTextColor}" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Path x:Name="CurveLine" StrokeThickness="2.2" Opacity="0.9" Stroke="{DynamicResource FxAccentTextBrush}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>

                    <UniformGrid x:Name="BandValues" Grid.Row="0" Grid.Column="3" Rows="1" Columns="10" />
                    <UniformGrid x:Name="BandSliders" Grid.Row="1" Grid.Column="3" Rows="1" Columns="10" />
                    <UniformGrid x:Name="BandLabels" Grid.Row="2" Grid.Column="3" Rows="1" Columns="10" />
                </Grid>
            </Border>

            <Grid Margin="2,10,2,0">
                <TextBlock x:Name="StatusText" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock HorizontalAlignment="Right" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Double-click a band: 0 dB  ·  Arrow keys: ±0.5 dB" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
