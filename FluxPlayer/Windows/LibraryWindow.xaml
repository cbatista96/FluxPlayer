<ui:FluentWindow x:Class="FluxPlayer.Windows.LibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Library · FluxPlayer" Width="1080" Height="680" MinWidth="820" MinHeight="500" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Background="Transparent">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Your library" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Music, videos and favorites in one place" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Add folder…" Click="AddFolder_Click" Padding="16,8" />
                <Button Content="Refresh" Click="Refresh_Click" Padding="14,8" Margin="8,0,0,0" />
                <Button Content="Watched folders" Click="WatchedFolders_Click" Padding="14,8" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" MinWidth="160" Height="34" Padding="10,5" TextChanged="Search_Changed" ToolTip="Search text or rules: artist:&quot;First Last&quot; format:flac duration:&gt;3:00 plays:&gt;2 added:&gt;=2026-01-01. Use - to exclude." AutomationProperties.Name="Search the library" />
            <TextBlock Text="Search title, artist, album or rules…" Margin="12,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <ComboBox x:Name="KindFilter" Grid.Column="1" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All media" /><ComboBoxItem Content="Audio" /><ComboBoxItem Content="Video" />
            </ComboBox>
            <ComboBox x:Name="CollectionFilter" Grid.Column="2" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Entire library" /><ComboBoxItem Content="Favorites" /><ComboBoxItem Content="Recently played" />
                <ComboBoxItem Content="Most played" /><ComboBoxItem Content="Not played" /><ComboBoxItem Content="Tags not analyzed" />
            </ComboBox>
            <CheckBox x:Name="WatchNewFolder" Grid.Column="3" Content="Watch when adding" IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,10,0,0">
                <ComboBox x:Name="SmartListCombo" Width="240" DisplayMemberPath="Name" SelectionChanged="SmartList_Changed" AutomationProperties.Name="Saved smart playlists" />
                <Button Content="Save view as playlist…" Click="SaveSmartList_Click" Margin="10,0,0,0" Padding="12,5" />
                <Button Content="Remove saved playlist" Click="RemoveSmartList_Click" Margin="8,0,0,0" Padding="12,5" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" CornerRadius="10" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="MediaGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="40" BorderThickness="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" MouseDoubleClick="Play_Click" PreviewKeyDown="Grid_KeyDown">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="★" Binding="{Binding Favorite}" Width="36" />
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" MinWidth="180" />
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" MinWidth="110" />
                        <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="*" MinWidth="110" />
                        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="75" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80" />
                        <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" Text="Add a folder to get started. Files you play will also appear here." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="470" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <WrapPanel>
                <Button Content="Play" Click="Play_Click" Padding="14,7" />
                <Button Content="Add to playlist" Click="Enqueue_Click" Margin="8,0,0,0" Padding="14,7" />
                <Button Content="Favorite" Click="Favorite_Click" Margin="8,0,0,0" Padding="14,7" />
                <Button Content="Read tags" Click="Analyze_Click" Margin="8,0,0,0" Padding="14,7" />
                <Button Content="Edit tags" Click="EditTags_Click" Margin="8,0,0,0" Padding="14,7" />
                <Button Content="Export playlist" Click="Export_Click" Margin="8,0,0,0" Padding="14,7" />
                <Button Content="Library tools" Click="LibraryTools_Click" Margin="8,0,0,0" Padding="14,7" />
                <Button x:Name="CancelButton" Content="Cancel task" Click="Cancel_Click" Visibility="Collapsed" Margin="8,0,0,0" Padding="14,7" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Text="Loading library…" FontSize="11" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
