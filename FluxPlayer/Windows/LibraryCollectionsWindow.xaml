<ui:FluentWindow x:Class="FluxPlayer.Windows.LibraryCollectionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Library collections · FluxPlayer" Width="820" Height="650" MinWidth="680" MinHeight="560" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" WindowBackdropType="Mica" Background="Transparent">
 <Grid Margin="24,18,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="Library collections" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Group indexed files without moving them. Collections can contain child collections; a file can belong to more than one." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
  <DataGrid x:Name="CollectionsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Selection_Changed" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="40" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Collection hierarchy">
   <DataGrid.Columns><DataGridTextColumn Header="Collection hierarchy" Binding="{Binding Display}" Width="*"/><DataGridTextColumn Header="Direct files" Binding="{Binding Count}" Width="100"/></DataGrid.Columns>
  </DataGrid>
  <Grid x:Name="Editor" Grid.Row="2" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="Name" Margin="0,0,0,6"/><TextBox x:Name="NameBox" MaxLength="120" Padding="10,7" AutomationProperties.Name="Collection name"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="Parent collection" Margin="0,0,0,6"/><ComboBox x:Name="ParentCombo" DisplayMemberPath="Display" SelectedValuePath="Id" MaxDropDownHeight="300" AutomationProperties.Name="Parent collection"/></StackPanel>
  </Grid>
  <StackPanel Grid.Row="3"><WrapPanel x:Name="Actions"><Button Content="New collection" Click="New_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Save name and parent" Click="Save_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Remove collection tree…" Click="Remove_Click" Padding="14,8" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock x:Name="Status" Text="Choose a collection to rename or move, or start a new collection." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
  </StackPanel>
 </Grid>
</ui:FluentWindow>
