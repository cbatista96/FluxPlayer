<ui:FluentWindow x:Class="FluxPlayer.Windows.SpokenMediaWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Spoken media · FluxPlayer" Width="1100" Height="760" MinWidth="950" MinHeight="660" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" WindowBackdropType="Mica" Background="Transparent">
 <Grid Margin="24,18,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
  <StackPanel x:Name="PodcastControls" Grid.Row="1" Margin="0,0,0,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Feed address (HTTP or HTTPS)" Margin="0,0,0,5"/><TextBox x:Name="FeedAddress" MaxLength="8192" Padding="10,7" AutomationProperties.Name="Podcast feed address"/></StackPanel>
    <Button Grid.Column="1" Content="Subscribe" Click="Subscribe_Click" VerticalAlignment="Bottom" Padding="14,8" Margin="10,0,0,0"/>
    <Button Grid.Column="2" Content="OPML…" Click="Opml_Click" VerticalAlignment="Bottom" Padding="14,8" Margin="8,0,0,0"/>
   </Grid>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="Feeds" DisplayMemberPath="Title" SelectionChanged="Feed_Changed" AutomationProperties.Name="Podcast subscription"/>
    <Button Grid.Column="1" Content="Refresh feed" Click="FeedRefresh_Click" Padding="14,7" Margin="10,0,0,0"/>
    <Button Grid.Column="2" Content="Unsubscribe…" Click="Unsubscribe_Click" Padding="14,7" Margin="8,0,0,0"/>
   </Grid>
  </StackPanel>
  <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Search titles" Grid.ColumnSpan="3" Margin="0,0,0,6"/>
   <ui:TextBox PlaceholderText="Search spoken media" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" x:Name="Search" Grid.Row="1" TextChanged="Search_Changed" Padding="10,7" AutomationProperties.Name="Search spoken media" ToolTip="Search titles"/>
   <ComboBox x:Name="EpisodeFilter" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Feed_Changed" AutomationProperties.Name="Episode filter"><ComboBoxItem Content="All episodes"/><ComboBoxItem Content="Not listened"/><ComboBoxItem Content="Downloaded"/></ComboBox>
   <Button Grid.Row="1" Grid.Column="2" Content="Refresh view" Click="Refresh_Click" Padding="14,7" Margin="10,0,0,0"/>
  </Grid>
  <Grid Grid.Row="3">
   <DataGrid x:Name="Books" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" RowHeight="38" MouseDoubleClick="Play_Click" AutomationProperties.Name="Audiobooks">
    <DataGrid.Columns><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="190"/><DataGridTextColumn Header="Speed" Binding="{Binding Rate, StringFormat={}{0:0.##}×}" Width="80"/><DataGridTextColumn Header="Bookmarks" Binding="{Binding Bookmarks.Length}" Width="100"/></DataGrid.Columns>
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGrid.RowStyle>
   </DataGrid>
   <DataGrid x:Name="Episodes" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" RowHeight="38" MouseDoubleClick="Play_Click" AutomationProperties.Name="Podcast episodes">
    <DataGrid.Columns><DataGridTextColumn Header="Episode" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Published (UTC)" Binding="{Binding PublishedUtc.UtcDateTime, StringFormat=yyyy-MM-dd}" Width="130"/><DataGridTextColumn Header="State" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Position" Binding="{Binding Progress}" Width="95"/><DataGridTemplateColumn Header="Offline" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="—"/><Style.Triggers><DataTrigger Binding="{Binding Downloaded}" Value="True"><Setter Property="Text" Value="Saved"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
   </DataGrid>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,14,0,0">
   <WrapPanel x:Name="BookActions"><Button Content="Add audio files…" Click="AddBooks_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Resume selected" Click="Play_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Restart" Click="Restart_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Speed…" Click="Speed_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Bookmarks…" Click="Bookmarks_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Completion…" Click="Completion_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Remove from shelf…" Click="RemoveBook_Click" Padding="13,8" Margin="0,0,0,8"/></WrapPanel>
   <WrapPanel x:Name="EpisodeActions"><Button Content="Play / resume" Click="Play_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Download episode" Click="Download_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Listening state…" Click="Completion_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Remove download…" Click="RemoveDownload_Click" Padding="13,8" Margin="0,0,0,8"/></WrapPanel>
   <DockPanel><Button x:Name="CancelJob" DockPanel.Dock="Right" Content="Cancel task" Click="Cancel_Click" Padding="12,6" Margin="12,0,0,0" Visibility="Collapsed"/><TextBlock x:Name="Status" Text="Loading…" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></DockPanel>
  </StackPanel>
 </Grid>
</ui:FluentWindow>
