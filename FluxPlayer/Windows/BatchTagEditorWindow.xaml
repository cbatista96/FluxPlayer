<ui:FluentWindow x:Class="FluxPlayer.Windows.BatchTagEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Batch tag editor · FluxPlayer" Width="960" Height="700" MinWidth="800" MinHeight="600"
    WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <Style x:Key="ResultCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="FileCell" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="ToolTip" Value="{Binding Path}"/>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Edit tags in batches" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="Check the fields to change. Unchecked fields are kept; a checked empty field clears its tag. Changes are written to the original files when their format supports them."
                TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <Grid x:Name="FieldsPanel" Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,12,14">
                <CheckBox x:Name="ApplyTitle" Content="Change title for every file" Margin="0,0,0,7"/>
                <TextBox x:Name="TitleBox" IsEnabled="{Binding IsChecked, ElementName=ApplyTitle}" MaxLength="4096" Padding="10,7" AutomationProperties.Name="Batch title"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,0,14">
                <CheckBox x:Name="ApplyArtist" Content="Change artist" Margin="0,0,0,7"/>
                <TextBox x:Name="ArtistBox" IsEnabled="{Binding IsChecked, ElementName=ApplyArtist}" MaxLength="4096" Padding="10,7" AutomationProperties.Name="Batch artist"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,12,0">
                <CheckBox x:Name="ApplyAlbum" Content="Change album" Margin="0,0,0,7"/>
                <TextBox x:Name="AlbumBox" IsEnabled="{Binding IsChecked, ElementName=ApplyAlbum}" MaxLength="4096" Padding="10,7" AutomationProperties.Name="Batch album"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1">
                <CheckBox x:Name="ApplyGenre" Content="Change genre" Margin="0,0,0,7"/>
                <TextBox x:Name="GenreBox" IsEnabled="{Binding IsChecked, ElementName=ApplyGenre}" MaxLength="4096" Padding="10,7" AutomationProperties.Name="Batch genre"/>
            </StackPanel>
        </Grid>
        <StackPanel x:Name="FileActions" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Add files…" Click="Add_Click" Padding="14,8"/>
            <Button Content="Remove selected from this job" Click="Remove_Click" Padding="14,8" Margin="8,0,0,0"/>
        </StackPanel>
        <DataGrid x:Name="FilesGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
            SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="38"
            HeadersVisibility="Column" GridLinesVisibility="None" AutomationProperties.Name="Tag edit results">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*" MinWidth="180" ElementStyle="{StaticResource FileCell}"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="95" ElementStyle="{StaticResource ResultCell}"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="3*" ElementStyle="{StaticResource ResultCell}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <ProgressBar x:Name="JobProgress" Height="5" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartButton" Content="Apply checked fields" Click="Start_Click" Padding="20,9"/>
                <Button x:Name="CancelButton" Content="Cancel after current file" Click="Cancel_Click" IsEnabled="False" Padding="16,9" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="Add local files and choose the fields to change." TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
