<ui:FluentWindow x:Class="FluxPlayer.Windows.LyricsEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Lyrics editor · FluxPlayer" Width="840" Height="640" MinWidth="700" MinHeight="520"
 ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner">
 <Grid Margin="24,18,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="Lyrics editor" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="Edit synchronized LRC text. Apply a session preview or save a new copy; existing files are preserved." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
   <TextBlock Text="{Binding NowPlayingTitle, StringFormat=Current media: {0}}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
  <WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,10">
   <Button Content="Open LRC…" Click="Open_Click" Padding="14,8" Margin="0,0,8,8"/>
   <Button Content="Load current sidecar" IsEnabled="{Binding HasMedia}" Click="Sidecar_Click" Padding="14,8" Margin="0,0,8,8"/>
   <Button Content="Insert current time" IsEnabled="{Binding HasMedia}" Click="Insert_Click" Padding="14,8" Margin="0,0,8,8"/>
   <Button Content="Apply to current media" IsEnabled="{Binding HasMedia}" Click="Apply_Click" Padding="14,8" Margin="0,0,8,8"/>
   <Button Content="Save LRC copy…" Click="Save_Click" Padding="14,8" Margin="0,0,8,8"/>
  </WrapPanel>
  <TextBox x:Name="Editor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="14" FontFamily="Cascadia Mono, Consolas" FontSize="14" MaxLength="2000000" AutomationProperties.Name="Synchronized lyric text"/>
  <TextBlock x:Name="Status" Grid.Row="3" Text="Use [00:01.250] before each lyric. Offset metadata and repeated timestamps are supported." Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
 </Grid>
</ui:FluentWindow>
