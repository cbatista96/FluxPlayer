<ui:FluentWindow x:Class="FluxPlayer.Windows.AdvancedCueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Advanced CUE editor · FluxPlayer" Width="1060" Height="780" MinWidth="820" MinHeight="620" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" WindowBackdropType="Mica" Background="Transparent">
 <Grid Margin="24,18,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="Advanced CUE editor" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Preserve CD-TEXT, gaps, flags, extra indexes, comments and unknown directives. Copies keep references pointing to their original files." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
  <WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,12">
   <Button Content="Open CUE…" Click="Open_Click" Padding="14,8" Margin="0,0,8,8"/>
   <ComboBox x:Name="EncodingChoice" SelectedIndex="0" Width="190" Margin="0,0,8,8" AutomationProperties.Name="CUE import encoding"><ComboBoxItem Content="UTF-8 / Unicode BOM"/><ComboBoxItem Content="Windows-1252"/></ComboBox>
   <Button Content="Validate and list tracks" Click="Validate_Click" Padding="14,8" Margin="0,0,8,8"/>
   <Button x:Name="PlayButton" Content="Play selected INDEX 01" Click="Play_Click" Padding="14,8" Margin="0,0,8,8" IsEnabled="False"/>
   <Button x:Name="SaveButton" Content="Save UTF-8 copy…" Click="Save_Click" Padding="14,8" Margin="0,0,0,8" IsEnabled="False"/>
  </WrapPanel>
  <TextBox x:Name="DocumentText" Grid.Row="2" FontFamily="Cascadia Mono, Consolas" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12" TextChanged="Document_Changed" MaxLength="4194304" AutomationProperties.Name="CUE document text"/>
  <DataGrid x:Name="Tracks" Grid.Row="3" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowHeight="32" HeadersVisibility="Column" GridLinesVisibility="None" EnableRowVirtualization="True" AutomationProperties.Name="Validated CUE track navigation">
   <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="44"/><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="100"/><DataGridTextColumn Header="INDEX 01" Binding="{Binding Start}" Width="110"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*"/></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="Navigation uses AUDIO INDEX 01 only. Gaps/flags and extra indexes are retained for editing; they do not enable CD burning, silence synthesis or gapless playback." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="Status" Text="Open a CUE document to begin. Saves always create a separate copy." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
 </Grid>
</ui:FluentWindow>
