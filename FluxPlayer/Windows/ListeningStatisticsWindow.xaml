<ui:FluentWindow x:Class="FluxPlayer.Windows.ListeningStatisticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Listening statistics · FluxPlayer" Width="1000" Height="680" MinWidth="820" MinHeight="560" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" WindowBackdropType="Mica" Background="Transparent">
 <Grid Margin="24,18,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="Listening statistics" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Note" Text="Based on retained audio playback history. Enable recording in Settings > Library." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Group by" Margin="0,0,0,5"/><ComboBox x:Name="Group" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Statistics grouping"><ComboBoxItem Content="Artists"/><ComboBoxItem Content="Tracks"/><ComboBoxItem Content="Days"/></ComboBox></StackPanel>
   <StackPanel Grid.Column="1" Margin="12,0,12,0"><TextBlock Text="Period (session start, UTC)" Margin="0,0,0,5"/><ComboBox x:Name="Period" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Statistics period"><ComboBoxItem Content="All retained history"/><ComboBoxItem Content="Last 7 days"/><ComboBoxItem Content="Last 30 days"/><ComboBoxItem Content="Last 90 days"/></ComboBox></StackPanel>
   <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" Padding="14,8" VerticalAlignment="Bottom"/>
  </Grid>
  <TextBlock x:Name="Totals" Grid.Row="2" FontSize="18" Margin="0,0,0,14"/>
  <DataGrid x:Name="Rows" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="38" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Listening statistics"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Sessions" Binding="{Binding Sessions}" Width="100"/><DataGridTextColumn Header="Completed" Binding="{Binding Completed}" Width="110"/><DataGridTextColumn Header="Listening time" Binding="{Binding Listened}" SortMemberPath="PlayedMs" Width="145"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="4" Margin="0,14,0,0"><Button Content="Export this view to a new CSV…" Click="Export_Click" HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,10"/><TextBlock x:Name="Status" Text="Loading…" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
 </Grid>
</ui:FluentWindow>
