<ui:FluentWindow x:Class="FluxPlayer.Windows.PlaybackSessionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Saved playback sessions · FluxPlayer" Width="1020" Height="680" MinWidth="840" MinHeight="560" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" WindowBackdropType="Mica" Background="Transparent">
 <Grid Margin="24,18,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="Saved playback sessions" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Save the queue, selected item, position, speed, repeat and shuffle. Restoring replaces the current queue; unavailable local files are skipped." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" VerticalAlignment="Bottom" Padding="14,8" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Search session names" Margin="0,0,0,6"/><TextBox x:Name="Search" TextChanged="Search_Changed" Padding="10,7" ToolTip="Search saved session names" AutomationProperties.Name="Search saved sessions"/></StackPanel></DockPanel>
  <DataGrid x:Name="Sessions" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="38" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Saved playback sessions"><DataGrid.Columns><DataGridTextColumn Header="Session" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Entries" Binding="{Binding Count}" Width="90"/><DataGridTextColumn Header="Position" Binding="{Binding Position}" SortMemberPath="PositionMs" Width="125"/><DataGridTextColumn Header="Speed" Binding="{Binding Rate, StringFormat={}{0:0.##}×}" Width="80"/><DataGridTextColumn Header="Repeat" Binding="{Binding Repeat}" Width="85"/><DataGridTemplateColumn Header="Shuffle" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Off"/><Style.Triggers><DataTrigger Binding="{Binding Shuffle}" Value="True"><Setter Property="Text" Value="On"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="3" Margin="0,14,0,0"><WrapPanel x:Name="Actions"><Button Content="Save current as…" Click="Save_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Replace selected…" Click="Replace_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Restore queue" Click="Restore_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Restore and play" Click="Play_Click" Padding="13,8" Margin="0,0,8,8"/><Button Content="Remove session…" Click="Remove_Click" Padding="13,8" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="Status" Text="Loading…" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
 </Grid>
</ui:FluentWindow>
